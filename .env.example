ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
ARK_IMAGE_SIZE=2K
ARK_IMAGE_RESPONSE_FORMAT=url
ARK_IMAGE_OUTPUT_FORMAT=jpeg
IMAGE_MODEL_TIMEOUT_SECONDS=90
ARK_VISION_MODEL=doubao-seed-2-0-pro-260215
VISION_MODEL_TIMEOUT_SECONDS=60
IMAGE_PROVIDER=ark
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=
COMFYUI_PROMPT_NODE_ID=
COMFYUI_PROMPT_INPUT=text
COMFYUI_TIMEOUT_MS=90000
COMFYUI_TIMEOUT_SECONDS=90
RAG_ENABLED=true
RAG_INCLUDE_CANDIDATES=false
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.5
RAG_COLLECTION_NAME=posterpilot_poster_rules
CHROMA_URL=http://127.0.0.1:8000
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT_MS=120000
EMBEDDING_TIMEOUT_SECONDS=120
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
TEXT_MODEL_TIMEOUT_SECONDS=60
POSTERPILOT_API_PORT=8787
POSTERPILOT_API_HOST=127.0.0.1
POSTERPILOT_ENV=development
LANGGRAPH_CHECKPOINT_PATH=data/langgraph-checkpoints.sqlite3
POSTERPILOT_LOG_LEVEL=INFO
POSTERPILOT_DATA_DIR=data
POSTERPILOT_DATABASE_URL=sqlite:///data/posterpilot.sqlite3
DEEPGAZE_BASE_URL=http://127.0.0.1:8001
DEEPGAZE_TIMEOUT_MS=60000
DEEPGAZE_TIMEOUT_SECONDS=60

# DeepSeek handles intent parsing, text planning, and image analysis with one credential.
INTENT_ROUTING_MODE=deepseek
VISION_PROVIDER=deepseek
# Empty means reuse DEEPSEEK_TEXT_MODEL. Use your platform's exact model ID/base URL.
DEEPSEEK_VISION_MODEL=
# ARK_API_KEY / ARK_IMAGE_MODEL remain the separate Seedream image-generation settings.
